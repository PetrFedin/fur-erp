# Local dev: run `docker compose up db -d` then copy this file to .env
DATABASE_URL="postgresql://fur_erp:fur_erp@localhost:5436/fur_erp"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me"

# Directory for uploaded files (fitting photos). Back it up together with the DB.
UPLOAD_DIR="./uploads"

# Демо-доступ под формой входа: задавайте ТОЛЬКО для закрытого тестового стенда, не для сайта, открытого всем
# DEMO_LOGIN_EMAIL="demo@example.ru"
# DEMO_SUPPLIER_EMAIL="wellmekh@demo.mvst"
# DEMO_SUPPLIER_PASSWORD=...
# DEMO_LOGIN_PASSWORD="..."
