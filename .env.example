# Local dev: run `docker compose up db -d` then copy this file to .env
DATABASE_URL="postgresql://fur_erp:fur_erp@localhost:5436/fur_erp"

NEXTAUTH_URL="http://localhost:3000"
# Секрет сессий. Для `npm run dev` годится любой; для боевого запуска (`next start`, Docker) приложение отвергает слабые
# значения: нужно не короче 32 символов — сгенерируйте: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me"

# Directory for uploaded files (fitting photos). Back it up together with the DB.
UPLOAD_DIR="./uploads"

# Демо-доступ под формой входа: задавайте ТОЛЬКО для закрытого тестового стенда, не для сайта, открытого всем
# DEMO_LOGIN_EMAIL="demo@example.ru"
# DEMO_SUPPLIER_EMAIL="wellmekh@demo.local"
# DEMO_SUPPLIER_PASSWORD=...
# DEMO_LOGIN_PASSWORD="..."

# Telegram-мост чата (см. docs/DEPLOY.md): токен от @BotFather; без него чат работает только внутри платформы
# TELEGRAM_BOT_TOKEN=""
# Чат для оповещений о сбое пересборки витрины (id чата владельца или группы; бот должен быть в нём). Пусто — только лог [mart][alert].
# ALERT_TELEGRAM_CHAT_ID=""
# TELEGRAM_API_BASE="https://api.telegram.org"
# TELEGRAM_WEBHOOK_SECRET=""

# Витрина данных: фоновая пересборка после записей (по умолчанию через 90 с после последней правки; 0 — выключить, например для тестов)
# MART_AUTO_REFRESH=0
# MART_REFRESH_DELAY_MS=90000
