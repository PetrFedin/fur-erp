# Образец. Обычно .env создаёт скрипт:  sh deploy/setup-env.sh   (он подставляет случайные секреты).
# Файл .env НИКОГДА не коммитить, не пересылать в чатах и не присылать на проверку.

# Адрес сайта без https://  . Без своего домена: <IP-сервера через дефисы>.sslip.io, например 185-12-34-56.sslip.io
# Для варианта «с ноутбука через туннель» значение любое (например localhost).
DOMAIN=erp.example.ru

# Пароль базы (openssl rand -hex 16) и секрет подписи входа (openssl rand -base64 32, не короче 32 знаков!).
DB_PASSWORD=ЗАМЕНИТЕ
AUTH_SECRET=ЗАМЕНИТЕ

# Общий замок на весь сайт (Caddy). Хэш: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'пароль'
# Значение хэша ОБЯЗАТЕЛЬНО в одинарных кавычках (в нём есть знаки $).
BASIC_USER=tester
BASIC_HASH='ЗАМЕНИТЕ'

# Включает нужные части docker-compose: server — Caddy с HTTPS на этом сервере; tunnel — туннель с ноутбука.
COMPOSE_PROFILES=server

# ---- Переключатели безопасности. Для публичного стенда ВСЕ ТРИ оставьте false ----
# Регистрация новых компаний самими посетителями.
ALLOW_REGISTRATION=false
# Демо-пароли на странице входа (иначе их увидит любой, у кого есть ссылка).
ALLOW_DEMO_LOGIN=false
# Кнопка владельца «Сменить на кабинет поставщика» (только для показа владельцем самому себе).
ALLOW_ROLE_SWITCH=false

# ---- Необязательно: Telegram (см. docs/DEPLOY.md) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Демо-сборка без вшитых реальных справочников (для стенда с обезличенной базой): true
DEMO_BUILD=false
