# Скопируйте в .env на сервере и заполните. Файл .env НИКОГДА не коммитить и не пересылать в чатах.

# Адрес сайта без https:// . Для быстрого старта без покупки домена: <IP-сервера через дефисы>.sslip.io
# например 185-12-34-56.sslip.io  (точки в IP заменить на дефисы). Со своим доменом: erp.вашдомен.ru
DOMAIN=erp.example.ru

# Пароль базы данных (придумайте длинный, только латиница и цифры): openssl rand -hex 16
DB_PASSWORD=ЗАМЕНИТЕ

# Секрет подписи входа: openssl rand -base64 32
AUTH_SECRET=ЗАМЕНИТЕ

# Регистрация новых компаний на сайте: false (закрыта) — для тестирования заказчиком.
ALLOW_REGISTRATION=false
