{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-san/types/**/*.ts",
    ".next-san/dev/types/**/*.ts",
    ".next-fx/types/**/*.ts",
    ".next-fx/dev/types/**/*.ts",
    ".next-sec/types/**/*.ts",
    ".next-sec/dev/types/**/*.ts",
    ".next-perf/types/**/*.ts",
    ".next-perf/dev/types/**/*.ts",
    ".next-perf-dev/types/**/*.ts",
    ".next-perf-dev/dev/types/**/*.ts",
    ".next-perf2/types/**/*.ts",
    ".next-perf2/dev/types/**/*.ts",
    ".next-perf3/types/**/*.ts",
    ".next-perf3/dev/types/**/*.ts",
    ".next-perimdev/types/**/*.ts",
    ".next-perimdev/dev/types/**/*.ts",
    ".next-perim/types/**/*.ts",
    ".next-perim/dev/types/**/*.ts",
    ".next-stat/types/**/*.ts",
    ".next-stat/dev/types/**/*.ts",
    ".next-edit/types/**/*.ts",
    ".next-edit/dev/types/**/*.ts",
    ".next-train/types/**/*.ts",
    ".next-train/dev/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-test/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
