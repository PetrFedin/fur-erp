// Fur ERP — multi-tenant schema
// Tenancy model: every business table carries organizationId and is scoped
// to it at the application layer (see src/lib/tenant.ts). Postgres RLS is
// not used in v1 — documented tradeoff, can be added later for defense in depth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & auth ----------

/// Справочник цветов: каноническое русское название + синонимы (английские и вариации написания из реестра и приложений ТЗ).
model ColorRef {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  aliases        String[]
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseItems PurchaseItem[]
  lots          RawMaterialLot[]
  orders        ProductionOrder[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Справочник меха: русское и английское названия + синонимы (в инвойсах — английские, в ТЗ — русские).
model FurRef {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  aliases        String[]
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Сезон производства/продаж (например FW26/27).
model Season {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime     @default(now())

  orders ProductionOrder[]
  plans  ProductionPlan[]
  events CalendarEvent[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// План заказа: артикул (из справочника или введённый вручную) и количества по размерам.
model ProductionPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seasonId       String?
  season         Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  modelId        String?
  articleCode    String
  articleName    String?
  color          String?
  furType        String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sizes  ProductionPlanSize[]
  events CalendarEvent[]

  @@index([organizationId])
  @@index([seasonId])
}

model ProductionPlanSize {
  id       String         @id @default(cuid())
  planId   String
  plan     ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  size     String
  quantity Int

  @@unique([planId, size])
}

/// Событие производственного календаря: артикул + количество (обязательно), дата, действие.
/// action — строка из списка в коде (раскрой, пошив, примерка, отгрузка, …), чтобы список можно было расширять без миграций.
model CalendarEvent {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime
  endDate        DateTime?
  articleCode    String
  articleName    String?
  quantity       Int
  action         String
  seasonId       String?
  season         Season?         @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  planId         String?
  plan           ProductionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  orderId        String?
  notes          String?
  doneAt         DateTime?
  createdById    String?
  createdAt      DateTime        @default(now())

  @@index([organizationId, date])
  @@index([seasonId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("trial")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  colorRefs              ColorRef[]
  furRefs                FurRef[]
  seasons                Season[]
  productionPlans        ProductionPlan[]
  calendarEvents         CalendarEvent[]
  clients                Client[]
  suppliers              Supplier[]
  warehouses             Warehouse[]
  rawMaterialCategories  RawMaterialCategory[]
  rawMaterials           RawMaterial[]
  expenseCategories      ExpenseCategory[]
  purchases              Purchase[]
  payments               Payment[]
  productionPayments     ProductionPayment[]
  rawMaterialLots        RawMaterialLot[]
  stockMovements         StockMovement[]
  productModels          ProductModel[]
  productionOrders       ProductionOrder[]
  finishedGoodsStocks    FinishedGoodsStock[]
  finishedGoodsMovements FinishedGoodsMovement[]
  supplyPlanEntries      SupplyPlanEntry[]
  shipments              Shipment[]
  fittings               Fitting[]
  purchaseDocuments      PurchaseDocument[]
  customFields           CustomField[]
  productionBatches      ProductionBatch[]
  driveDocuments         DriveDocument[]
}

enum UserRole {
  OWNER
  ADMIN
  PURCHASER
  WAREHOUSE
  TECHNOLOGIST
  ACCOUNTANT
  VIEWER
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(VIEWER)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdPurchases        Purchase[]        @relation("PurchaseCreatedBy")
  createdProductionOrders ProductionOrder[] @relation("ProductionOrderCreatedBy")

  @@index([organizationId])
}

// ---------- Reference data ----------

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  inn            String?
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchases      Purchase[]
  payments       Payment[]
  driveDocuments DriveDocument[]

  @@index([organizationId])
}

// A customer commissioning production (давалец/заказчик по договору подряда) —
// distinct from Supplier, which is who we buy raw material from.
model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  inn            String?
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  productionOrders   ProductionOrder[]
  productionPayments ProductionPayment[]
  shipments          Shipment[]
  driveDocuments     DriveDocument[]

  @@index([organizationId])
}

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  rawMaterialLots        RawMaterialLot[]
  stockMovements         StockMovement[]
  purchasesIn            Purchase[]              @relation("PurchaseWarehouse")
  productionOrdersRaw    ProductionOrder[]       @relation("ProductionOrderRawWarehouse")
  productionOrdersOut    ProductionOrder[]       @relation("ProductionOrderFinishedWarehouse")
  finishedGoodsStocks    FinishedGoodsStock[]
  finishedGoodsMovements FinishedGoodsMovement[]

  @@index([organizationId])
}

enum MaterialUnit {
  PIECE
  KG
  M2
  M
  SET
}

model RawMaterialCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String

  rawMaterials RawMaterial[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RawMaterial {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       RawMaterialCategory? @relation(fields: [categoryId], references: [id])
  name           String
  sku            String?
  unit           MaterialUnit         @default(PIECE)
  minStockLevel  Decimal?             @db.Decimal(14, 3)
  description    String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  purchaseItems         PurchaseItem[]
  stockMovements        StockMovement[]
  lots                  RawMaterialLot[]
  productModelMaterials ProductModelMaterial[]
  productionUsages      ProductionMaterialUsage[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

enum ExpenseCategoryKind {
  PURCHASE
  PRODUCTION
  GENERAL
}

model ExpenseCategory {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           ExpenseCategoryKind
  isActive       Boolean             @default(true)

  purchaseExpenses   PurchaseExpense[]
  productionExpenses ProductionExpense[]

  @@unique([organizationId, name, kind])
  @@index([organizationId])
}

// ---------- Purchasing ----------

enum PurchaseStatus {
  DRAFT
  ORDERED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model Purchase {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number           String
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  warehouseId      String
  warehouse        Warehouse      @relation("PurchaseWarehouse", fields: [warehouseId], references: [id])
  status           PurchaseStatus @default(DRAFT)
  currency         String         @default("RUB")
  // Rate of `currency` -> RUB, entered manually per purchase (auction/invoice
  // rate on the deal date). Item prices are in `currency`; this converts them
  // to RUB for landed-cost and stock valuation. 1 for RUB purchases.
  exchangeRate     Decimal        @default(1) @db.Decimal(14, 6)
  // Free-text fields matching how a fur-auction purchase is actually
  // documented (auction/session name e.g. "СП 05.25", invoice number, and
  // the УПД transfer-document reference) — informational, shown on the
  // purchase and carried onto its lots for the archive.
  auctionSession   String?
  invoiceNumber    String?
  transferDocument String?
  orderDate        DateTime       @default(now())
  expectedDate     DateTime?
  receivedDate     DateTime?
  notes            String?
  createdById      String?
  createdBy        User?          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items           PurchaseItem[]
  expenses        PurchaseExpense[]
  payments        Payment[]
  stockMovements  StockMovement[]
  rawMaterialLots RawMaterialLot[]
  documents       PurchaseDocument[]
  driveDocuments  DriveDocument[]
  // Подтверждение строки человеком (или автоматически по документам): «сумма и документ корректны».
  // verifiedBy: id пользователя либо "auto:<основание>"; сброс = null.
  verifiedAt      DateTime?
  verifiedBy      String?
  verifyNote      String?

  @@unique([organizationId, number])
  @@index([organizationId])
}

// One line = one purchased lot/batch (лот) of a raw material. unitPrice and
// subtotal are the price EXCLUDING VAT, in the purchase's currency;
// converted to RUB via purchase.exchangeRate and grossed up by vatRate when
// the item is received into a RawMaterialLot. vatRate varies lot to lot —
// the rate in force can change between purchases (seen 20% and 22% in the
// same registry across 2025/2026).
model PurchaseItem {
  id            String      @id @default(cuid())
  purchaseId    String
  purchase      Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  quantity      Decimal     @db.Decimal(14, 3)
  unitPrice     Decimal     @db.Decimal(14, 2)
  subtotal      Decimal     @db.Decimal(14, 2)
  vatRate       Decimal     @default(20) @db.Decimal(5, 2)
  lotNumber     String?
  grade         String?
  color         String?
  colorRefId    String?
  colorRef      ColorRef?   @relation(fields: [colorRefId], references: [id], onDelete: SetNull)
  notes         String?

  // FK lives here (not on RawMaterialLot) so more than one PurchaseItem can
  // point at the same lot: fur stays one-to-one in practice (each receipt
  // creates its own specific-identification lot — see createRawMaterialLot),
  // but lining fabric (RawMaterial.unit === "M") pools every receipt into one
  // aggregate RawMaterialLot per fabric, so a second/third purchase of the
  // same fabric adds a new PurchaseItem row pointing at the SAME lot instead
  // of forcing a 1:1 relation that can't express that. See addOrPoolLiningLot
  // in src/lib/stock.ts and the cfc5cd6/this-commit history for why.
  lotId String?
  lot   RawMaterialLot? @relation(fields: [lotId], references: [id])

  // Предварительный расчёт стоимости единицы из расчётного листа закупки
  // (аукционный сбор, выделка, транспорт, брокерский %, НДС ...):
  // { unitCostInclVat, materialExclVat, materialVat, expenseExclVat,
  //   expenseVat (всё за единицу, ₽), breakdown: [{label, value}] }.
  // Если задан, receivePurchase берёт из него стоимость единицы лота вместо
  // распределения расходов закупки пропорционально стоимости (выделка и
  // транспорт считаются на штуку, а не от цены) и копирует breakdown в лот.
  costPlan Json?

  // Значения «своих столбцов» (CustomField): { [customFieldId]: string | number | boolean }.
  extra Json?

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@index([lotId])
}

// Extra costs tied to a purchase: shipping, customs, insurance, commission, inspection loss, etc.
// amount is in RUB, excluding VAT; vatRate defaults to 0 since many fees
// (commissions, some services) are quoted flat with no VAT to add — set it
// per line when the invoice itemizes VAT separately (auction/customs fees
// commonly do).
model PurchaseExpense {
  id          String          @id @default(cuid())
  purchaseId  String
  purchase    Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Decimal         @db.Decimal(14, 2)
  vatRate     Decimal         @default(0) @db.Decimal(5, 2)
  date        DateTime        @default(now())
  description String?

  @@index([purchaseId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Payments to a supplier. purchaseId is optional so advance/prepayments not
// yet tied to a specific delivery can be recorded and reconciled later.
model Payment {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  purchaseId     String?
  purchase       Purchase?         @relation(fields: [purchaseId], references: [id])
  amount         Decimal           @db.Decimal(14, 2)
  currency       String            @default("RUB")
  method         PaymentMethod     @default(BANK_TRANSFER)
  status         PaymentStatus     @default(COMPLETED)
  paidAt         DateTime          @default(now())
  notes          String?
  createdAt      DateTime          @default(now())
  // Оплата аукциона целиком (Purchase.auctionSession, первая строка): purchaseId
  // при этом пуст. PENDING = запланирована (будущая оплата по графику),
  // COMPLETED = оплачена. percent — доля от стоимости аукциона, если вводили %.
  auctionSession String?
  kind           PaymentKind       @default(OTHER)
  percent        Decimal?          @db.Decimal(7, 3)
  // Платёжный документ (PurchaseDocument kind PAYMENT_PROOF, batch = аукцион).
  documentId     String?
  confirmedAt    DateTime?
  confirmedBy    String?
  document       PurchaseDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  // Номер платёжки / счёта, по которому прошла оплата; confirmed = false — оплата
  // упомянута в документах, но подтверждения (платёжки) ещё нет.
  docRef         String?
  confirmed      Boolean           @default(true)
  driveDocuments DriveDocument[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([organizationId, auctionSession])
  @@index([documentId])
}

enum PaymentKind {
  ADVANCE // аванс
  PARTIAL // частичная оплата / доплата
  FINAL // окончательный расчёт
  OTHER
}

// Payments received FROM a client for production work (ТЗ) — a separate
// ledger from `Payment` (which is what we pay suppliers for raw material),
// since the two sides of the business are billed independently.
// A client payment doesn't always land against one specific ТЗ — a client
// may pay an advance before any order exists, or one lump sum that covers
// several finished orders at once. `client` lets a payment be recorded
// against the client alone (e.g. an advance), and `orders` optionally
// allocates it to one or more specific ТЗ (checked off when recording the
// payment) — same shape as an invoice payment covering several invoices.
enum ProductionPaymentType {
  ADVANCE // аванс — before/without a specific ТЗ
  PARTIAL // доплата — partial payment against one or more ТЗ
  FINAL // окончательная оплата
}

model ProductionPayment {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?                  @relation(fields: [clientId], references: [id])
  amount         Decimal                  @db.Decimal(14, 2)
  paymentType    ProductionPaymentType    @default(FINAL)
  method         PaymentMethod            @default(BANK_TRANSFER)
  status         PaymentStatus            @default(COMPLETED)
  paidAt         DateTime                 @default(now())
  notes          String?
  createdAt      DateTime                 @default(now())
  orders         ProductionPaymentOrder[]
  docRef         String?
  confirmed      Boolean                  @default(true)
  confirmedAt    DateTime?
  confirmedBy    String?
  driveDocuments DriveDocument[]

  @@index([organizationId])
  @@index([clientId])
}

// Join table: which ТЗ a given payment was allocated to (0, 1, or many).
model ProductionPaymentOrder {
  id                  String            @id @default(cuid())
  productionPaymentId String
  productionPayment   ProductionPayment @relation(fields: [productionPaymentId], references: [id], onDelete: Cascade)
  productionOrderId   String
  productionOrder     ProductionOrder   @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@unique([productionPaymentId, productionOrderId])
  @@index([productionOrderId])
}

// ---------- Raw material stock (lot-based / specific identification) ----------
//
// Fur pelts of the same material can vary 3-4x in cost lot to lot (auction
// batch, quality, source), so a blended weighted-average would distort
// per-product costing badly. Each purchased lot is its own inventory unit
// with a cost fixed at receipt; production draws down specific lots by name,
// matching how the business's own registry (and every downstream report)
// already works. "Current stock by material" is a live aggregate query over
// this table, not a separately maintained cache — avoids drift.

enum StockMovementType {
  PURCHASE_IN
  PRODUCTION_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

// One received batch/lot of a raw material. lotNumber is the external
// identifier (auction/supplier lot number) when there is one — optional,
// since not every material is lot-tracked by the supplier (e.g. lining
// fabric sold by the running metre).
model RawMaterialLot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rawMaterialId  String
  rawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  lotNumber      String?
  grade          String?
  color          String?
  colorRefId     String?
  colorRef       ColorRef?    @relation(fields: [colorRefId], references: [id], onDelete: SetNull)

  purchaseId    String?
  purchase      Purchase?      @relation(fields: [purchaseId], references: [id])
  // Reverse side of PurchaseItem.lotId (see its comment): a fur lot has
  // exactly one PurchaseItem in practice, but a lining pool lot can have
  // many, one per receipt that fed it — hence a list here, not a unique
  // one-to-one FK owned by this side.
  purchaseItems PurchaseItem[]

  quantityReceived    Decimal @db.Decimal(14, 3)
  quantityRemaining   Decimal @db.Decimal(14, 3)
  // Landed cost per unit in RUB, fixed at receipt: (item price incl. its
  // own VAT + this lot's share of the purchase's allocated expenses, incl.
  // their VAT) * exchange rate. Every consumption of this lot is costed at
  // this rate. materialCostExclVat/materialVatAmount below break out just
  // the raw-material component (not the allocated expenses) for the
  // detail view — VAT rate is stored per lot since it varies by purchase
  // date (20% vs. 22% seen in the same registry).
  unitCost            Decimal @db.Decimal(14, 2)
  totalCost           Decimal @db.Decimal(14, 2)
  vatRate             Decimal @db.Decimal(5, 2)
  materialCostExclVat Decimal @db.Decimal(14, 2)
  materialVatAmount   Decimal @db.Decimal(14, 2)
  // Per-unit split of this lot's share of the purchase's allocated expenses
  // (shipping/customs/etc. — see PurchaseExpense), broken into excl-VAT and
  // VAT-amount components. Added for the "без НДС" display toggle: the
  // allocation in receivePurchase splits the *inclusive* expense pool by a
  // single per-item ratio, so applying that same ratio to the pool's own
  // excl-VAT/VAT-amount split is exact, not an approximation (excl + vat =
  // incl by construction). 0/0 for lots with no purchaseId (manual/adjustment
  // lots never had expenses allocated). Combined with materialCostExclVat/
  // materialVatAmount above, (materialCostExclVat + expenseCostExclVat) is
  // the fully correct excl-VAT landed unit cost.
  expenseCostExclVat  Decimal @default(0) @db.Decimal(14, 2)
  expenseVatAmount    Decimal @default(0) @db.Decimal(14, 2)

  receivedDate DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  // Ordered list of {label, value} cost components the source purchase
  // report itemized for this lot (auction fee, broker %, dressing/tanning,
  // customs advance, agent commission, freight, ...) — the ingredients
  // "из чего складывается" unitCost, kept for full traceability. Only
  // present where the source gave this level of detail (currently the
  // FW26 season report); older lots only ever had the final landed cost.
  costBreakdown Json?

  stockMovements StockMovement[]
  usages         ProductionMaterialUsage[]
  driveDocuments DriveDocument[]

  @@index([organizationId])
  @@index([warehouseId, rawMaterialId])
  @@index([organizationId, lotNumber])
}

// Append-only audit ledger of every lot movement (received, consumed,
// adjusted, transferred).
model StockMovement {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id])
  rawMaterialId     String
  rawMaterial       RawMaterial       @relation(fields: [rawMaterialId], references: [id])
  lotId             String?
  lot               RawMaterialLot?   @relation(fields: [lotId], references: [id])
  type              StockMovementType
  quantity          Decimal           @db.Decimal(14, 3)
  unitCost          Decimal           @db.Decimal(14, 2)
  totalCost         Decimal           @db.Decimal(14, 2)
  purchaseId        String?
  purchase          Purchase?         @relation(fields: [purchaseId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder?  @relation(fields: [productionOrderId], references: [id])
  date              DateTime          @default(now())
  notes             String?
  createdAt         DateTime          @default(now())

  @@index([organizationId])
  @@index([warehouseId, rawMaterialId])
  @@index([lotId])
}

// ---------- Production ----------

model ProductModel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  category       String?
  // Справочник артикулов: код и название этого же изделия в системе продаж + прочие написания.
  salesCode      String?
  salesName      String?
  aliases        String[]
  sellingPrice   Decimal?     @db.Decimal(14, 2)
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  materials              ProductModelMaterial[]
  productionOrders       ProductionOrder[]
  finishedGoodsStocks    FinishedGoodsStock[]
  finishedGoodsMovements FinishedGoodsMovement[]
  supplyPlanEntries      SupplyPlanEntry[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

// Higher-level planning: what's expected to move through which stage in
// which calendar month, independent of a specific ТЗ (production order).
// Stage names/order come from the user's own production-tracking sheet
// (запуск → в работе у скорняка → в работе у портной → сдано).
enum SupplyPlanStatus {
  PLANNED
  LAUNCHED
  WITH_FURRIER
  WITH_TAILOR
  PRODUCED
  CANCELLED
}

model SupplyPlanEntry {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productModelId String
  productModel   ProductModel     @relation(fields: [productModelId], references: [id], onDelete: Cascade)
  month          DateTime // first day of the planned month
  status         SupplyPlanStatus @default(PLANNED)
  quantity       Decimal          @db.Decimal(14, 3)
  eventDate      DateTime? // specific date tied to the status (launch date, delivery date, etc.)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([productModelId])
  @@index([month])
}

// Bill of materials: how much of each raw material one unit of a model consumes.
model ProductModelMaterial {
  id              String       @id @default(cuid())
  productModelId  String
  productModel    ProductModel @relation(fields: [productModelId], references: [id], onDelete: Cascade)
  rawMaterialId   String
  rawMaterial     RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  quantityPerUnit Decimal      @db.Decimal(14, 3)
  notes           String?

  @@unique([productModelId, rawMaterialId])
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id                  String                @id @default(cuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number              String
  productModelId      String
  productModel        ProductModel          @relation(fields: [productModelId], references: [id])
  rawWarehouseId      String
  rawWarehouse        Warehouse             @relation("ProductionOrderRawWarehouse", fields: [rawWarehouseId], references: [id])
  finishedWarehouseId String
  finishedWarehouse   Warehouse             @relation("ProductionOrderFinishedWarehouse", fields: [finishedWarehouseId], references: [id])
  status              ProductionOrderStatus @default(PLANNED)
  plannedQuantity     Decimal               @db.Decimal(14, 3)
  producedQuantity    Decimal               @default(0) @db.Decimal(14, 3)
  color               String?
  seasonId            String?
  season              Season?               @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  colorRefId          String?
  colorRef            ColorRef?             @relation(fields: [colorRefId], references: [id], onDelete: SetNull)
  size                String?
  // Free-text description of the product material as written on the ТЗ
  // (e.g. "Соболь выделанный тонированный") — separate from the BOM's raw
  // material catalog entries, which may be more granular.
  materialDescription String?
  lining              String?
  startDate           DateTime?
  endDate             DateTime?
  notes               String?
  createdById         String?
  createdBy           User?                 @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id])

  // Optional: production done under a client work order (давальческая /
  // подрядная схема) — a Технического задания attached to a Договор подряда.
  clientId               String?
  client                 Client?   @relation(fields: [clientId], references: [id])
  contractNumber         String?
  workOrderNumber        String?
  workOrderDate          DateTime?
  // Price charged to the client per produced unit for the manufacturing
  // work itself (revenue) — separate from our internal production cost.
  clientWorkPricePerUnit Decimal?  @db.Decimal(14, 2)

  // Партия поставки (в Drive — «поставка N»), к которой относится ТЗ.
  batchId String?
  batch   ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // Intended/actual retail sale price per unit for this specific batch (own
  // sales channel, not the давалец client) — markup = retailPrice / unitCost.
  retailPrice Decimal? @db.Decimal(14, 2)

  // Cost snapshot, filled in when the order is marked COMPLETED so reports
  // stay stable even if later stock cost movements change the average.
  materialCost Decimal? @db.Decimal(14, 2)
  expenseCost  Decimal? @db.Decimal(14, 2)
  totalCost    Decimal? @db.Decimal(14, 2)
  unitCost     Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialUsages         ProductionMaterialUsage[]
  expenses               ProductionExpense[]
  paymentAllocations     ProductionPaymentOrder[]
  shipmentLines          ShipmentLine[]
  fittings               Fitting[]
  stockMovements         StockMovement[]
  finishedGoodsMovements FinishedGoodsMovement[]
  driveDocuments         DriveDocument[]
  // Подтверждение строки человеком (или автоматически по документам): «сумма и документ корректны».
  // verifiedBy: id пользователя либо "auto:<основание>"; сброс = null.
  verifiedAt             DateTime?
  verifiedBy             String?
  verifyNote             String?

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([batchId])
}

// Actual raw-material consumption recorded against a production order
// (can differ from the model's BOM in practice — waste, substitutions).
model ProductionMaterialUsage {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  lotId             String
  lot               RawMaterialLot  @relation(fields: [lotId], references: [id])
  quantity          Decimal         @db.Decimal(14, 3)
  unitCost          Decimal         @db.Decimal(14, 2)
  totalCost         Decimal         @db.Decimal(14, 2)
  date              DateTime        @default(now())
  // Применять ли к строке надбавку 4% (см. src/lib/commission4.ts): сырьё и
  // подкладка — да; лоскут, фондю, бобр, отдельные партии — нет.
  commission4       Boolean         @default(true)

  @@index([productionOrderId])
  @@index([lotId])
}

// Non-material production costs: labor, fittings/trim, rent, depreciation, etc.
model ProductionExpense {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  categoryId        String
  category          ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount            Decimal         @db.Decimal(14, 2)
  date              DateTime        @default(now())
  description       String?

  @@index([productionOrderId])
}

// ---------- Finished goods stock ----------

enum FinishedGoodsMovementType {
  PRODUCTION_IN
  WRITE_OFF_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model FinishedGoodsMovement {
  id                String                    @id @default(cuid())
  organizationId    String
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse                 @relation(fields: [warehouseId], references: [id])
  productModelId    String
  productModel      ProductModel              @relation(fields: [productModelId], references: [id])
  type              FinishedGoodsMovementType
  quantity          Decimal                   @db.Decimal(14, 3)
  unitCost          Decimal                   @db.Decimal(14, 2)
  totalCost         Decimal                   @db.Decimal(14, 2)
  productionOrderId String?
  productionOrder   ProductionOrder?          @relation(fields: [productionOrderId], references: [id])
  date              DateTime                  @default(now())
  notes             String?
  createdAt         DateTime                  @default(now())

  @@index([organizationId])
  @@index([warehouseId, productModelId])
}

model FinishedGoodsStock {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  productModelId String
  productModel   ProductModel @relation(fields: [productModelId], references: [id])
  quantity       Decimal      @default(0) @db.Decimal(14, 3)
  avgUnitCost    Decimal      @default(0) @db.Decimal(14, 2)
  updatedAt      DateTime     @updatedAt

  @@unique([warehouseId, productModelId])
  @@index([organizationId])
}

// Планируемые/выполненные отгрузки готовой продукции заказчику: по
// уведомлению об отгрузке выбираются ТЗ, размеры и количество, плановая дата.
enum ShipmentStatus {
  PLANNED
  SHIPPED
  CANCELLED
}

model Shipment {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  plannedDate    DateTime
  shippedDate    DateTime?
  status         ShipmentStatus @default(PLANNED)
  notes          String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lines          ShipmentLine[]

  @@index([organizationId, status])
  @@index([plannedDate])
}

model ShipmentLine {
  id                String          @id @default(cuid())
  shipmentId        String
  shipment          Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  size              String?
  quantity          Int

  @@index([shipmentId])
  @@index([productionOrderId])
}

// Журнал примерок: по ТЗ (а значит и по модели) — дата, размер, итог,
// комментарий и фото, сделанные по факту примерки.
enum FittingStatus {
  PLANNED
  HELD_REMARKS
  HELD_OK
}

model Fitting {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  fittingDate       DateTime
  size              String?
  status            FittingStatus   @default(PLANNED)
  comment           String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  photos            FittingPhoto[]

  @@index([organizationId])
  @@index([productionOrderId])
}

model FittingPhoto {
  id           String   @id @default(cuid())
  fittingId    String
  fitting      Fitting  @relation(fields: [fittingId], references: [id], onDelete: Cascade)
  storagePath  String
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([fittingId])
}

enum PurchaseDocumentKind {
  AUCTION_INVOICE // счёт аукциона на лоты
  SPECIFICATION // спецификация / приложение к договору
  ADVANCE_INVOICE // счёт на аванс
  CALC_SHEET // расчётный лист (Excel)
  UPD // УПД / акт
  PAYMENT_PROOF // платёжный документ (платёжка)
  OTHER
}

// Документ закупки: лежит на диске в UPLOAD_DIR (см. src/lib/purchase-files.ts).
// purchaseId задан — документ относится к одной закупке (счёт аукциона на её
// лоты); иначе документ партии — все закупки с тем же `batch`
// (Purchase.auctionSession, напр. «СП 09-26»): спецификация, расчётный лист,
// счёт на аванс.
model PurchaseDocument {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseId     String?
  purchase       Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  batch          String?
  kind           PurchaseDocumentKind @default(OTHER)
  title          String
  storagePath    String
  originalName   String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime             @default(now())
  payments       Payment[]

  @@index([organizationId, batch])
  @@index([purchaseId])
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
}

// Свой столбец таблицы лотов (режим «Аукцион» и карточка закупки): общий для всей
// организации. Значения лежат в PurchaseItem.extra по ключу id столбца.
model CustomField {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         String          @default("PURCHASE_ITEM")
  name           String
  type           CustomFieldType @default(TEXT)
  position       Int             @default(0)
  createdAt      DateTime        @default(now())

  @@unique([organizationId, entity, name])
  @@index([organizationId, entity, position])
}

// ---------- Партии производства и документы Google Drive ----------

// Партия поставки производства (в Google Drive — «поставка N»): группирует ТЗ.
model ProductionBatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         Int
  name           String?
  year           Int?
  plannedUnits   Int?
  notes          String?
  createdAt      DateTime     @default(now())

  orders         ProductionOrder[]
  driveDocuments DriveDocument[]
  // Подтверждение строки человеком (или автоматически по документам): «сумма и документ корректны».
  // verifiedBy: id пользователя либо "auto:<основание>"; сброс = null.
  verifiedAt     DateTime?
  verifiedBy     String?
  verifyNote     String?

  @@unique([organizationId, number])
  @@index([organizationId])
}

enum DriveDocType {
  AUCTION_INVOICE
  UPD
  CALC_SHEET
  SPECIFICATION
  CONTRACT
  TZ_APPENDIX
  PAYMENT_PROOF
  PAYMENT_INVOICE
  APPROVAL_EMAIL
  BALANCE
  OTHER
}

// Ссылка на файл в Google Drive (сам файл не хранится). Один файл может быть
// привязан к нескольким сущностям — отдельной строкой на каждую привязку.
model DriveDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driveFileId    String
  title          String
  docType        DriveDocType @default(OTHER)
  mimeType       String?
  sizeBytes      Int?
  drivePath      String?
  viewUrl        String?
  docDate        DateTime?
  docNumber      String?
  year           Int?
  notes          String?
  createdAt      DateTime     @default(now())
  // Оригинал файла в приложении (необязательно): путь относительно UPLOAD_DIR, имя на диске — uuid.
  storagePath    String?
  storedName     String?
  storedMime     String?
  storedSize     Int?
  storedAt       DateTime?

  purchaseId          String?
  purchase            Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  lotId               String?
  lot                 RawMaterialLot?    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  productionOrderId   String?
  productionOrder     ProductionOrder?   @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionBatchId   String?
  productionBatch     ProductionBatch?   @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  paymentId           String?
  payment             Payment?           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  productionPaymentId String?
  productionPayment   ProductionPayment? @relation(fields: [productionPaymentId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplierId          String?
  supplier            Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([organizationId, driveFileId])
  @@index([purchaseId])
  @@index([lotId])
  @@index([productionOrderId])
  @@index([productionBatchId])
  @@index([paymentId])
  @@index([productionPaymentId])
  @@index([clientId])
  @@index([supplierId])
}
