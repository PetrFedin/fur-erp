// Fur ERP — multi-tenant schema
// Tenancy model: every business table carries organizationId and is scoped
// to it at the application layer (see src/lib/tenant.ts). Postgres RLS is
// not used in v1 — documented tradeoff, can be added later for defense in depth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & auth ----------

/// Справочник цветов: каноническое русское название + синонимы (английские и вариации написания из реестра и приложений ТЗ).
model ColorRef {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  aliases        String[]
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseItems PurchaseItem[]
  lots          RawMaterialLot[]
  orders        ProductionOrder[]
  orderColors   ProductionOrderColor[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Справочник категорий изделий (Пальто, Полупальто, Жакет…): каноническое русское название + синонимы (свободный текст ProductModel.category).
model CategoryRef {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Группа верхнего уровня: «Одежда», «Аксессуары» (src/lib/category-groups.ts).
  group          String?
  aliases        String[]
  sortOrder      Int          @default(0)
  confirmed      Boolean      @default(false)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  models ProductModel[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Справочник аукционов: короткое имя на платформе (name), полное название из документов, дом, вид.
/// Purchase.auctionSession остаётся кэшем отображаемого имени и ключом в старых местах (оплаты, документы, реестр сверки).
model Auction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  fullName       String?
  house          String?
  kind           AuctionKind  @default(FUR)
  year           Int?
  month          Int?
  currency       String?
  auctionDate    DateTime?
  aliases        String[]
  isService      Boolean      @default(false)
  confirmed      Boolean      @default(false)
  sortOrder      Int          @default(0)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchases Purchase[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum AuctionKind {
  FUR
  LINING
  MATERIALS
  OTHER
}

/// Справочник меха: русское и английское названия + синонимы (в инвойсах — английские, в ТЗ — русские).
model FurRef {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  aliases        String[]
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Сезон производства/продаж (например FW26/27).
model Season {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime     @default(now())

  orders ProductionOrder[]
  plans  ProductionPlan[]
  events CalendarEvent[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// План заказа: артикул (из справочника или введённый вручную) и количества по размерам.
model ProductionPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seasonId       String?
  season         Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  modelId        String?
  articleCode    String
  articleName    String?
  color          String?
  furType        String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sizes  ProductionPlanSize[]
  events CalendarEvent[]

  @@index([organizationId])
  @@index([seasonId])
}

model ProductionPlanSize {
  id       String         @id @default(cuid())
  planId   String
  plan     ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  size     String
  quantity Int

  @@unique([planId, size])
}

/// Событие производственного календаря: артикул + количество (обязательно), дата, действие.
/// action — строка из списка в коде (раскрой, пошив, примерка, отгрузка, …), чтобы список можно было расширять без миграций.
model CalendarEvent {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime
  endDate        DateTime?
  articleCode    String
  articleName    String?
  quantity       Int
  action         String
  seasonId       String?
  season         Season?         @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  planId         String?
  plan           ProductionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  orderId        String?
  notes          String?
  doneAt         DateTime?
  createdById    String?
  createdAt      DateTime        @default(now())
  /// Запись внёс внешний поставщик (Веллмех): календарь по артикулу «этап · плановая и фактическая дата».
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Этап поставщика (ключ из src/lib/supplier-calendar.ts)
  status         String?
  factDate       DateTime?
  color          String?
  size           String?
  /// Номер ТЗ или отгрузки, к которому относится запись (по желанию)
  docNote        String?

  @@index([organizationId, date])
  @@index([seasonId])
  @@index([supplierId, date])
}

model Organization {
  rawStages SupplierRawStage[]
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("trial")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  colorRefs              ColorRef[]
  categoryRefs           CategoryRef[]
  auctions               Auction[]
  furRefs                FurRef[]
  seasons                Season[]
  productionPlans        ProductionPlan[]
  calendarEvents         CalendarEvent[]
  clients                Client[]
  suppliers              Supplier[]
  warehouses             Warehouse[]
  rawMaterialCategories  RawMaterialCategory[]
  rawMaterials           RawMaterial[]
  expenseCategories      ExpenseCategory[]
  purchases              Purchase[]
  payments               Payment[]
  invoices               Invoice[]
  productionPayments     ProductionPayment[]
  rawMaterialLots        RawMaterialLot[]
  stockMovements         StockMovement[]
  productModels          ProductModel[]
  productionOrders       ProductionOrder[]
  finishedGoodsStocks    FinishedGoodsStock[]
  finishedGoodsMovements FinishedGoodsMovement[]
  supplyPlanEntries      SupplyPlanEntry[]
  shipments              Shipment[]
  fittings               Fitting[]
  purchaseDocuments      PurchaseDocument[]
  customFields           CustomField[]
  productionBatches      ProductionBatch[]
  driveDocuments         DriveDocument[]
  systemStates           SystemState[]
  comments               Comment[]
  budgetScenarios        BudgetScenario[]
  furAttrRefs            FurAttrRef[]
  commentReplies         CommentReply[]
  paymentAllocations     PaymentAllocation[]
}

enum UserRole {
  OWNER
  ADMIN
  PURCHASER
  WAREHOUSE
  TECHNOLOGIST
  ACCOUNTANT
  VIEWER
  /// Внешний поставщик (кабинет Веллмеха): видит только свои отгрузки, артикулы без цен и справочники.
  SUPPLIER
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(VIEWER)
  isActive       Boolean      @default(true)
  /// Для роли SUPPLIER: чей это кабинет.
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdPurchases        Purchase[]        @relation("PurchaseCreatedBy")
  createdProductionOrders ProductionOrder[] @relation("ProductionOrderCreatedBy")
  shipmentEvents          ShipmentEvent[]   @relation("ShipmentEventResponsible")

  @@index([organizationId])
  @@index([supplierId])
}

/// Machine-readable admission markers for deterministic rebuilds and production readiness.
/// Values are operational metadata only; business facts remain in their domain tables.
model SystemState {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

// ---------- Reference data ----------

model Supplier {
  rawStages SupplierRawStage[]
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  inn            String?
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchases      Purchase[]
  payments       Payment[]
  invoices       Invoice[]
  driveDocuments DriveDocument[]
  shipments      Shipment[]
  users          User[]
  inbox          SupplierInbox[]
  calendarEvents CalendarEvent[]

  @@index([organizationId])
}

/// Счёт поставщика. Один счёт может покрывать несколько закупок (Purchase.invoiceId).
/// Реестр сверки с документами (src/data/reconciliation.json) здесь не хранится.
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  date           DateTime?
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  amountInclVat  Decimal?     @db.Decimal(14, 2)
  vatRate        Decimal?     @db.Decimal(5, 2)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  purchases      Purchase[]

  @@index([organizationId, supplierId, number])
}

// A customer commissioning production (давалец/заказчик по договору подряда) —
// distinct from Supplier, which is who we buy raw material from.
model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  inn            String?
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  productionOrders   ProductionOrder[]
  productionPayments ProductionPayment[]
  shipments          Shipment[]
  driveDocuments     DriveDocument[]

  @@index([organizationId])
}

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  rawMaterialLots        RawMaterialLot[]
  stockMovements         StockMovement[]
  purchasesIn            Purchase[]              @relation("PurchaseWarehouse")
  productionOrdersRaw    ProductionOrder[]       @relation("ProductionOrderRawWarehouse")
  productionOrdersOut    ProductionOrder[]       @relation("ProductionOrderFinishedWarehouse")
  finishedGoodsStocks    FinishedGoodsStock[]
  finishedGoodsMovements FinishedGoodsMovement[]

  @@index([organizationId])
}

enum MaterialUnit {
  PIECE
  KG
  M2
  M
  SET
}

model RawMaterialCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String

  rawMaterials RawMaterial[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RawMaterial {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       RawMaterialCategory? @relation(fields: [categoryId], references: [id])
  name           String
  sku            String?
  unit           MaterialUnit         @default(PIECE)
  minStockLevel  Decimal?             @db.Decimal(14, 3)
  description    String?
  /// Ставка НДС материала по умолчанию (%, для НОВЫХ лотов/позиций закупки и строк списания в ТЗ).
  /// null — «по лоту/по дате документа»: ставка берётся из лота, а для новых записей — по дате (до 2026 — 20, с 2026 — 22).
  defaultVatRate Decimal?             @db.Decimal(5, 2)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  purchaseItems         PurchaseItem[]
  stockMovements        StockMovement[]
  lots                  RawMaterialLot[]
  productModelMaterials ProductModelMaterial[]
  productionUsages      ProductionMaterialUsage[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

enum ExpenseCategoryKind {
  PURCHASE
  PRODUCTION
  GENERAL
}

model ExpenseCategory {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           ExpenseCategoryKind
  isActive       Boolean             @default(true)

  purchaseExpenses   PurchaseExpense[]
  productionExpenses ProductionExpense[]

  @@unique([organizationId, name, kind])
  @@index([organizationId])
}

// ---------- Purchasing ----------

enum PurchaseStatus {
  DRAFT
  ORDERED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model Purchase {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number           String
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  warehouseId      String
  warehouse        Warehouse      @relation("PurchaseWarehouse", fields: [warehouseId], references: [id])
  status           PurchaseStatus @default(DRAFT)
  currency         String         @default("RUB")
  // Rate of `currency` -> RUB, entered manually per purchase (auction/invoice
  // rate on the deal date). Item prices are in `currency`; this converts them
  // to RUB for landed-cost and stock valuation. 1 for RUB purchases.
  exchangeRate     Decimal        @default(1) @db.Decimal(14, 6)
  // Free-text fields matching how a fur-auction purchase is actually
  // documented (auction/session name e.g. "СП 05.25", invoice number, and
  // the УПД transfer-document reference) — informational, shown on the
  // purchase and carried onto its lots for the archive.
  auctionSession   String?
  auctionId        String?
  auction          Auction?       @relation(fields: [auctionId], references: [id], onDelete: SetNull)
  invoiceNumber    String?
  /// Дата счёта поставщика
  invoiceDate      DateTime?
  transferDocument String?
  /// Счёт поставщика (таблица Invoice); invoiceNumber/invoiceDate выше остаются и обновляются синхронно.
  invoiceId        String?
  invoice          Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  orderDate        DateTime       @default(now())
  expectedDate     DateTime?
  receivedDate     DateTime?
  notes            String?
  /// Это не отдельная закупка, а сырьё подрядчика, оплаченное в составе счетов за пошив (проверка документов смотрит на этот признак, а не на текст примечания).
  isContractorRaw  Boolean?
  /// Короткая подпись строки в списке «Закупки без аукциона» (например «шкуры подрядчика»).
  listLabel        String?
  createdById      String?
  createdBy        User?          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items           PurchaseItem[]
  expenses        PurchaseExpense[]
  payments        Payment[]
  stockMovements  StockMovement[]
  rawMaterialLots RawMaterialLot[]
  documents       PurchaseDocument[]
  rawStages       SupplierRawStage[]
  driveDocuments  DriveDocument[]
  // Подтверждение строки человеком (или автоматически по документам): «сумма и документ корректны».
  // verifiedBy: id пользователя либо "auto:<основание>"; сброс = null.
  verifiedAt      DateTime?
  verifiedBy      String?
  verifyNote      String?

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([invoiceId])
  @@index([auctionId])
}

// One line = one purchased lot/batch (лот) of a raw material. unitPrice and
// subtotal are the price EXCLUDING VAT, in the purchase's currency;
// converted to RUB via purchase.exchangeRate and grossed up by vatRate when
// the item is received into a RawMaterialLot. vatRate varies lot to lot —
// the rate in force can change between purchases (seen 20% and 22% in the
// same registry across 2025/2026).
model PurchaseItem {
  id            String      @id @default(cuid())
  purchaseId    String
  purchase      Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  quantity      Decimal     @db.Decimal(14, 3)
  unitPrice     Decimal     @db.Decimal(14, 2)
  subtotal      Decimal     @db.Decimal(14, 2)
  vatRate       Decimal     @default(20) @db.Decimal(5, 2)
  lotNumber     String?
  grade         String?
  color         String?
  colorRefId    String?
  colorRef      ColorRef?   @relation(fields: [colorRefId], references: [id], onDelete: SetNull)
  notes         String?

  // FK lives here (not on RawMaterialLot) so more than one PurchaseItem can
  // point at the same lot: fur stays one-to-one in practice (each receipt
  // creates its own specific-identification lot — see createRawMaterialLot),
  // but lining fabric (RawMaterial.unit === "M") pools every receipt into one
  // aggregate RawMaterialLot per fabric, so a second/third purchase of the
  // same fabric adds a new PurchaseItem row pointing at the SAME lot instead
  // of forcing a 1:1 relation that can't express that. See addOrPoolLiningLot
  // in src/lib/stock.ts and the cfc5cd6/this-commit history for why.
  lotId String?
  lot   RawMaterialLot? @relation(fields: [lotId], references: [id])

  // Предварительный расчёт стоимости единицы из расчётного листа закупки
  // (аукционный сбор, выделка, транспорт, брокерский %, НДС ...):
  // { unitCostInclVat, materialExclVat, materialVat, expenseExclVat,
  //   expenseVat (всё за единицу, ₽), breakdown: [{label, value}] }.
  // Если задан, receivePurchase берёт из него стоимость единицы лота вместо
  // распределения расходов закупки пропорционально стоимости (выделка и
  // транспорт считаются на штуку, а не от цены) и копирует breakdown в лот.
  costPlan Json?

  // Значения «своих столбцов» (CustomField): { [customFieldId]: string | number | boolean }.
  extra Json?

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@index([lotId])
}

// Extra costs tied to a purchase: shipping, customs, insurance, commission, inspection loss, etc.
// amount is in RUB, excluding VAT; vatRate defaults to 0 since many fees
// (commissions, some services) are quoted flat with no VAT to add — set it
// per line when the invoice itemizes VAT separately (auction/customs fees
// commonly do).
model PurchaseExpense {
  id          String          @id @default(cuid())
  purchaseId  String
  purchase    Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Decimal         @db.Decimal(14, 2)
  vatRate     Decimal         @default(0) @db.Decimal(5, 2)
  date        DateTime        @default(now())
  description String?

  @@index([purchaseId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Payments to a supplier. purchaseId is optional so advance/prepayments not
// yet tied to a specific delivery can be recorded and reconciled later.
model Payment {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  purchaseId     String?
  purchase       Purchase?         @relation(fields: [purchaseId], references: [id])
  amount         Decimal           @db.Decimal(14, 2)
  currency       String            @default("RUB")
  method         PaymentMethod     @default(BANK_TRANSFER)
  status         PaymentStatus     @default(COMPLETED)
  paidAt         DateTime          @default(now())
  notes          String?
  createdAt      DateTime          @default(now())
  // Оплата аукциона целиком (Purchase.auctionSession, первая строка): purchaseId
  // при этом пуст. PENDING = запланирована (будущая оплата по графику),
  // COMPLETED = оплачена. percent — доля от стоимости аукциона, если вводили %.
  auctionSession String?
  kind           PaymentKind       @default(OTHER)
  percent        Decimal?          @db.Decimal(7, 3)
  // Платёжный документ (PurchaseDocument kind PAYMENT_PROOF, batch = аукцион).
  documentId     String?
  confirmedAt    DateTime?
  confirmedBy    String?
  document       PurchaseDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  // Номер платёжки / счёта, по которому прошла оплата; confirmed = false — оплата
  // упомянута в документах, но подтверждения (платёжки) ещё нет.
  docRef         String?
  /// Номер счёта и номер п/п отдельными полями (docRef остаётся читаемой строкой для совместимости).
  invoiceNo      String?
  ppNo           String?
  confirmed      Boolean           @default(true)
  driveDocuments DriveDocument[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([organizationId, auctionSession])
  @@index([documentId])
}

enum PaymentKind {
  ADVANCE // аванс
  PARTIAL // частичная оплата / доплата
  FINAL // окончательный расчёт
  OTHER
}

// Payments received FROM a client for production work (ТЗ) — a separate
// ledger from `Payment` (which is what we pay suppliers for raw material),
// since the two sides of the business are billed independently.
// A client payment doesn't always land against one specific ТЗ — a client
// may pay an advance before any order exists, or one lump sum that covers
// several finished orders at once. `client` lets a payment be recorded
// against the client alone (e.g. an advance), and `orders` optionally
// allocates it to one or more specific ТЗ (checked off when recording the
// payment) — same shape as an invoice payment covering several invoices.
enum ProductionPaymentType {
  ADVANCE // аванс — before/without a specific ТЗ
  PARTIAL // доплата — partial payment against one or more ТЗ
  FINAL // окончательная оплата
}

model ProductionPayment {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?                  @relation(fields: [clientId], references: [id])
  amount         Decimal                  @db.Decimal(14, 2)
  paymentType    ProductionPaymentType    @default(FINAL)
  method         PaymentMethod            @default(BANK_TRANSFER)
  status         PaymentStatus            @default(COMPLETED)
  paidAt         DateTime                 @default(now())
  notes          String?
  createdAt      DateTime                 @default(now())
  orders         ProductionPaymentOrder[]
  docRef         String?
  invoiceNo      String?
  ppNo           String?
  confirmed      Boolean                  @default(true)
  confirmedAt    DateTime?
  confirmedBy    String?
  driveDocuments DriveDocument[]
  allocations    PaymentAllocation[]

  @@index([organizationId])
  @@index([clientId])
}

// Join table: which ТЗ a given payment was allocated to (0, 1, or many).
model ProductionPaymentOrder {
  id                  String            @id @default(cuid())
  productionPaymentId String
  productionPayment   ProductionPayment @relation(fields: [productionPaymentId], references: [id], onDelete: Cascade)
  productionOrderId   String
  productionOrder     ProductionOrder   @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@unique([productionPaymentId, productionOrderId])
  @@index([productionOrderId])
}

enum AllocationSource {
  AUTO
  MANUAL
}

// Разнесение оплаты производства по ТЗ: сколько рублей платежа относится к работе каждого ТЗ.
// Σ amount по платежу <= ProductionPayment.amount; остаток платежа = «неразнесённый аванс» (не относится ни к одному ТЗ).
// ProductionPaymentOrder остаётся «набором ТЗ, которые покрывает платёж» (документы, подписи), суммы — здесь.
model PaymentAllocation {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionPaymentId String
  productionPayment   ProductionPayment @relation(fields: [productionPaymentId], references: [id], onDelete: Cascade)
  productionOrderId   String
  productionOrder     ProductionOrder   @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  amount              Decimal           @db.Decimal(14, 2)
  note                String?
  source              AllocationSource  @default(MANUAL)
  createdAt           DateTime          @default(now())

  @@unique([productionPaymentId, productionOrderId])
  @@index([productionOrderId])
  @@index([organizationId])
}

// ---------- Raw material stock (lot-based / specific identification) ----------
//
// Fur pelts of the same material can vary 3-4x in cost lot to lot (auction
// batch, quality, source), so a blended weighted-average would distort
// per-product costing badly. Each purchased lot is its own inventory unit
// with a cost fixed at receipt; production draws down specific lots by name,
// matching how the business's own registry (and every downstream report)
// already works. "Current stock by material" is a live aggregate query over
// this table, not a separately maintained cache — avoids drift.

enum StockMovementType {
  PURCHASE_IN
  PRODUCTION_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

// One received batch/lot of a raw material. lotNumber is the external
// identifier (auction/supplier lot number) when there is one — optional,
// since not every material is lot-tracked by the supplier (e.g. lining
// fabric sold by the running metre).
model RawMaterialLot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rawMaterialId  String
  rawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  lotNumber      String?
  grade          String?
  /// Размер лота (XXL, XL, L, M, S…): разбор текста grade, см. src/lib/lot-size.ts. null — не распознан.
  sizeGrade      String?
  color          String?
  colorRefId     String?
  colorRef       ColorRef?    @relation(fields: [colorRefId], references: [id], onDelete: SetNull)

  purchaseId    String?
  purchase      Purchase?      @relation(fields: [purchaseId], references: [id])
  // Reverse side of PurchaseItem.lotId (see its comment): a fur lot has
  // exactly one PurchaseItem in practice, but a lining pool lot can have
  // many, one per receipt that fed it — hence a list here, not a unique
  // one-to-one FK owned by this side.
  purchaseItems PurchaseItem[]

  quantityReceived    Decimal @db.Decimal(14, 3)
  quantityRemaining   Decimal @db.Decimal(14, 3)
  // Landed cost per unit in RUB, fixed at receipt: (item price incl. its
  // own VAT + this lot's share of the purchase's allocated expenses, incl.
  // their VAT) * exchange rate. Every consumption of this lot is costed at
  // this rate. materialCostExclVat/materialVatAmount below break out just
  // the raw-material component (not the allocated expenses) for the
  // detail view — VAT rate is stored per lot since it varies by purchase
  // date (20% vs. 22% seen in the same registry).
  unitCost            Decimal @db.Decimal(14, 2)
  totalCost           Decimal @db.Decimal(14, 2)
  vatRate             Decimal @db.Decimal(5, 2)
  materialCostExclVat Decimal @db.Decimal(14, 2)
  materialVatAmount   Decimal @db.Decimal(14, 2)
  // Per-unit split of this lot's share of the purchase's allocated expenses
  // (shipping/customs/etc. — see PurchaseExpense), broken into excl-VAT and
  // VAT-amount components. Added for the "без НДС" display toggle: the
  // allocation in receivePurchase splits the *inclusive* expense pool by a
  // single per-item ratio, so applying that same ratio to the pool's own
  // excl-VAT/VAT-amount split is exact, not an approximation (excl + vat =
  // incl by construction). 0/0 for lots with no purchaseId (manual/adjustment
  // lots never had expenses allocated). Combined with materialCostExclVat/
  // materialVatAmount above, (materialCostExclVat + expenseCostExclVat) is
  // the fully correct excl-VAT landed unit cost.
  expenseCostExclVat  Decimal @default(0) @db.Decimal(14, 2)
  expenseVatAmount    Decimal @default(0) @db.Decimal(14, 2)

  receivedDate DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  // Ordered list of {label, value} cost components the source purchase
  // report itemized for this lot (auction fee, broker %, dressing/tanning,
  // customs advance, agent commission, freight, ...) — the ingredients
  // "из чего складывается" unitCost, kept for full traceability. Only
  // present where the source gave this level of detail (currently the
  // FW26 season report); older lots only ever had the final landed cost.
  costBreakdown Json?

  stockMovements StockMovement[]
  usages         ProductionMaterialUsage[]
  attrs          RawMaterialLotAttr[]
  rawStages      SupplierRawStage[]
  driveDocuments DriveDocument[]
  documents      PurchaseDocument[]

  @@index([organizationId])
  @@index([warehouseId, rawMaterialId])
  @@index([organizationId, lotNumber])
}

// Append-only audit ledger of every lot movement (received, consumed,
// adjusted, transferred).
model StockMovement {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id])
  rawMaterialId     String
  rawMaterial       RawMaterial       @relation(fields: [rawMaterialId], references: [id])
  lotId             String?
  lot               RawMaterialLot?   @relation(fields: [lotId], references: [id])
  type              StockMovementType
  quantity          Decimal           @db.Decimal(14, 3)
  unitCost          Decimal           @db.Decimal(14, 2)
  totalCost         Decimal           @db.Decimal(14, 2)
  purchaseId        String?
  purchase          Purchase?         @relation(fields: [purchaseId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder?  @relation(fields: [productionOrderId], references: [id])
  date              DateTime          @default(now())
  notes             String?
  createdAt         DateTime          @default(now())

  @@index([organizationId])
  @@index([warehouseId, rawMaterialId])
  @@index([lotId])
}

// ---------- Production ----------

model ProductModel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  category       String?
  categoryRefId  String?
  categoryRef    CategoryRef? @relation(fields: [categoryRefId], references: [id], onDelete: SetNull)
  // Справочник артикулов: код и название этого же изделия в системе продаж + прочие написания.
  salesCode      String?
  salesName      String?
  aliases        String[]
  /// Длина изделия по системе продаж: Short / Regular / Long (пусто — не задана или не применима, например аксессуары).
  lengthClass    String?
  sellingPrice   Decimal?     @db.Decimal(14, 2)
  description    String?
  /// Расценка работы за единицу, как прислал Веллмех (необязательно; наши цены и себестоимость — отдельно).
  supplierWorkPrice Decimal?  @db.Decimal(14, 2)
  /// Расход шкур на одно изделие, шт., как прислал Веллмех (необязательно).
  supplierFurPerUnit Decimal? @db.Decimal(10, 3)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  materials              ProductModelMaterial[]
  productionOrders       ProductionOrder[]
  finishedGoodsStocks    FinishedGoodsStock[]
  finishedGoodsMovements FinishedGoodsMovement[]
  supplyPlanEntries      SupplyPlanEntry[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryRefId])
}

// Higher-level planning: what's expected to move through which stage in
// which calendar month, independent of a specific ТЗ (production order).
// Stage names/order come from the user's own production-tracking sheet
// (запуск → в работе у скорняка → в работе у портной → сдано).
enum SupplyPlanStatus {
  PLANNED
  LAUNCHED
  WITH_FURRIER
  WITH_TAILOR
  PRODUCED
  CANCELLED
}

model SupplyPlanEntry {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productModelId String
  productModel   ProductModel     @relation(fields: [productModelId], references: [id], onDelete: Cascade)
  month          DateTime // first day of the planned month
  status         SupplyPlanStatus @default(PLANNED)
  quantity       Decimal          @db.Decimal(14, 3)
  eventDate      DateTime? // specific date tied to the status (launch date, delivery date, etc.)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([productModelId])
  @@index([month])
}

// Bill of materials: how much of each raw material one unit of a model consumes.
model ProductModelMaterial {
  id              String       @id @default(cuid())
  productModelId  String
  productModel    ProductModel @relation(fields: [productModelId], references: [id], onDelete: Cascade)
  rawMaterialId   String
  rawMaterial     RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  quantityPerUnit Decimal      @db.Decimal(14, 3)
  notes           String?

  @@unique([productModelId, rawMaterialId])
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id                  String                @id @default(cuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number              String
  productModelId      String
  productModel        ProductModel          @relation(fields: [productModelId], references: [id])
  rawWarehouseId      String
  rawWarehouse        Warehouse             @relation("ProductionOrderRawWarehouse", fields: [rawWarehouseId], references: [id])
  finishedWarehouseId String
  finishedWarehouse   Warehouse             @relation("ProductionOrderFinishedWarehouse", fields: [finishedWarehouseId], references: [id])
  status              ProductionOrderStatus @default(PLANNED)
  plannedQuantity     Decimal               @db.Decimal(14, 3)
  producedQuantity    Decimal               @default(0) @db.Decimal(14, 3)
  color               String?
  seasonId            String?
  season              Season?               @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  colorRefId          String?
  colorRef            ColorRef?             @relation(fields: [colorRefId], references: [id], onDelete: SetNull)
  size                String?
  // Free-text description of the product material as written on the ТЗ
  // (e.g. "Соболь выделанный тонированный") — separate from the BOM's raw
  // material catalog entries, which may be more granular.
  materialDescription String?
  lining              String?
  /// Ручной вид меха ТЗ (override). NULL — вид определяется по списанным лотам / тексту, как раньше.
  furTypeOverride     String?
  startDate           DateTime?
  endDate             DateTime?
  notes               String?
  /// ТЗ без партии по документам (отдельная поставка или переделка): «партия не указана» в «Внимании» не показывается.
  batchNotRequired    Boolean?
  createdById         String?
  createdBy           User?                 @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id])

  // Optional: production done under a client work order (давальческая /
  // подрядная схема) — a Технического задания attached to a Договор подряда.
  clientId               String?
  client                 Client?   @relation(fields: [clientId], references: [id])
  contractNumber         String?
  workOrderNumber        String?
  workOrderDate          DateTime?
  // Price charged to the client per produced unit for the manufacturing
  // work itself (revenue) — separate from our internal production cost.
  clientWorkPricePerUnit Decimal?  @db.Decimal(14, 2)
  /// Шкуры подрядчика (его сырьё, закупки у нас нет), шт.: только для справки о расходе, в деньги и остатки не входят.
  contractorHides        Int?

  /// Составной цвет ТЗ («Тёмно-синий ×2 (42, 46); Чёрный ×1 (42)»): по строке на цвет. У обычных ТЗ пусто — цвет в colorRefId.
  colors ProductionOrderColor[]

  // Партия поставки (в Drive — «поставка N»), к которой относится ТЗ.
  batchId String?
  batch   ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // Intended/actual retail sale price per unit for this specific batch (own
  // sales channel, not the давалец client) — markup = retailPrice / unitCost.
  retailPrice Decimal? @db.Decimal(14, 2)

  // Cost snapshot, filled in when the order is marked COMPLETED so reports
  // stay stable even if later stock cost movements change the average.
  materialCost Decimal? @db.Decimal(14, 2)
  expenseCost  Decimal? @db.Decimal(14, 2)
  totalCost    Decimal? @db.Decimal(14, 2)
  unitCost     Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attrs                  ProductionOrderAttr[]
  materialUsages         ProductionMaterialUsage[]
  expenses               ProductionExpense[]
  paymentAllocations     ProductionPaymentOrder[]
  payShares              PaymentAllocation[]
  shipmentLines          ShipmentLine[]
  fittings               Fitting[]
  stockMovements         StockMovement[]
  finishedGoodsMovements FinishedGoodsMovement[]
  driveDocuments         DriveDocument[]
  // Подтверждение строки человеком (или автоматически по документам): «сумма и документ корректны».
  // verifiedBy: id пользователя либо "auto:<основание>"; сброс = null.
  verifiedAt             DateTime?
  verifiedBy             String?
  verifyNote             String?

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([batchId])
}

// Actual raw-material consumption recorded against a production order
// (can differ from the model's BOM in practice — waste, substitutions).
model ProductionMaterialUsage {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  lotId             String
  lot               RawMaterialLot  @relation(fields: [lotId], references: [id])
  quantity          Decimal         @db.Decimal(14, 3)
  unitCost          Decimal         @db.Decimal(14, 2)
  totalCost         Decimal         @db.Decimal(14, 2)
  date              DateTime        @default(now())
  // Применять ли к строке надбавку 4% (см. src/lib/commission4.ts): сырьё и
  // подкладка — да; лоскут, фондю, бобр, отдельные партии — нет.
  commission4       Boolean         @default(true)
  // Ставка НДС строки списания, % (правится в карточке ТЗ). NULL = «как в лоте»:
  // эффективная ставка = vatRate ?? lot.vatRate. Сумма с НДС (totalCost) не меняется,
  // от ставки зависит только разбивка «без НДС / НДС».
  vatRate           Decimal?        @db.Decimal(5, 2)

  @@index([productionOrderId])
  @@index([lotId])
}

// Non-material production costs: labor, fittings/trim, rent, depreciation, etc.
model ProductionExpense {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  categoryId        String
  category          ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount            Decimal         @db.Decimal(14, 2)
  date              DateTime        @default(now())
  description       String?

  @@index([productionOrderId])
}

// ---------- Finished goods stock ----------

enum FinishedGoodsMovementType {
  PRODUCTION_IN
  WRITE_OFF_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model FinishedGoodsMovement {
  id                String                    @id @default(cuid())
  organizationId    String
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse                 @relation(fields: [warehouseId], references: [id])
  productModelId    String
  productModel      ProductModel              @relation(fields: [productModelId], references: [id])
  type              FinishedGoodsMovementType
  quantity          Decimal                   @db.Decimal(14, 3)
  unitCost          Decimal                   @db.Decimal(14, 2)
  totalCost         Decimal                   @db.Decimal(14, 2)
  productionOrderId String?
  productionOrder   ProductionOrder?          @relation(fields: [productionOrderId], references: [id])
  date              DateTime                  @default(now())
  notes             String?
  createdAt         DateTime                  @default(now())

  @@index([organizationId])
  @@index([warehouseId, productModelId])
}

model FinishedGoodsStock {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id])
  productModelId String
  productModel   ProductModel @relation(fields: [productModelId], references: [id])
  quantity       Decimal      @default(0) @db.Decimal(14, 3)
  avgUnitCost    Decimal      @default(0) @db.Decimal(14, 2)
  updatedAt      DateTime     @updatedAt

  @@unique([warehouseId, productModelId])
  @@index([organizationId])
}

// Планируемые/выполненные отгрузки готовой продукции заказчику: по
// уведомлению об отгрузке выбираются ТЗ, размеры и количество, плановая дата.
enum ShipmentStatus {
  PLANNED
  SHIPPED
  CANCELLED
  /// Приёмка подтверждена кнопкой «Принято» (Shipment.acceptedAt).
  ACCEPTED
}

model Shipment {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?          @relation(fields: [clientId], references: [id])
  /// Название отгрузки («Отгрузка октябрь 2026 · 1»); у старых записей пусто.
  name           String?
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Партия пошива, к которой относится отгрузка (необязательно).
  batchId        String?
  batch          ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  plannedDate    DateTime
  shippedDate    DateTime?
  status         ShipmentStatus   @default(PLANNED)
  notes          String?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lines          ShipmentLine[]
  /// Хронология: этапы отгрузки, которые заводят вручную (свободное название, дата-время, ответственный).
  events         ShipmentEvent[]
  /// Приёмка подтверждена: когда (настенное время), кем (текстом) и каким этапом хронологии.
  acceptedAt     DateTime?
  acceptedBy     String?
  acceptEventId  String?

  @@index([organizationId, status])
  @@index([plannedDate])
  @@index([supplierId])
  @@index([batchId])
}

model ShipmentLine {
  id                String               @id @default(cuid())
  shipmentId        String
  shipment          Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// Позиция ТЗ; пусто у «своего» артикула, которого ещё нет в ТЗ (тогда заполнен customArticle).
  productionOrderId String?
  productionOrder   ProductionOrder?     @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  /// Свой артикул/название, если в ТЗ его ещё нет (productionOrderId пусто).
  customArticle     String?
  size              String?
  quantity          Int
  /// Цвет и вид меха — копия на момент добавления из ТЗ (для показа и поиска, не источник правды).
  color             String?
  furKind           String?
  /// Единый комментарий строки (причина возврата / замечание).
  comment           String?
  /// Приёмка по строке: сколько принято и сколько возвращено поставщику (не принято); null — ещё не отмечено.
  acceptedQty       Int?
  returnedQty       Int?
  /// Стадия изделия до отгрузки: просмотр → (доработка) → готов к отгрузке. Финальная приёмка (acceptedQty/returnedQty) — только при READY.
  stage             ShipmentLineStage    @default(REVIEW)
  /// Номер изделия из списка («279»; у нескольких штук одной строки — «259, 260»).
  itemNo            String?
  stageChangedAt    DateTime?
  stageChangedBy    String?
  reworks           ShipmentLineRework[]
  /// Устарело: приёмка по этапам больше не используется ни в интерфейсе, ни в итогах (таблица остаётся в БД).
  eventLines        ShipmentEventLine[]

  @@index([shipmentId])
  @@index([productionOrderId])
}

enum ShipmentLineStage {
  REVIEW
  REWORK
  READY
}

enum ShipmentReworkState {
  OPEN
  DONE
  MORE
}

/// Пункт доработки по строке отгрузки: что именно доработать, состояние, комментарий (где доработка / что изменено).
model ShipmentLineRework {
  id          String              @id @default(cuid())
  lineId      String
  line        ShipmentLine        @relation(fields: [lineId], references: [id], onDelete: Cascade)
  text        String
  state       ShipmentReworkState @default(OPEN)
  note        String?
  createdAt   DateTime            @default(now())
  createdById String
  updatedAt   DateTime            @updatedAt
  updatedById String?

  @@index([lineId])
}

/// Этап отгрузки: свободное название, дата-время (время может быть неизвестно), ответственный, детализация.
/// occurredAt хранится как «настенное» время (UTC-метка без пересчёта поясов): 09.10.2026 19:07 = 2026-10-09T19:07Z.
model ShipmentEvent {
  id                String              @id @default(cuid())
  shipmentId        String
  shipment          Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  title             String
  occurredAt        DateTime
  timeKnown         Boolean             @default(true)
  responsibleUserId String?
  responsibleUser   User?               @relation("ShipmentEventResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  /// Внешний ответственный текстом («Василий (Веллмех)»).
  responsibleName   String?
  /// На ком этап: "WELLMEKH" (Веллмех) | "CUM" (ЦУМ); null — не указано.
  side              String?
  place             String?
  details           String?
  /// Ссылки на документы этапа (по одной в строке).
  docLinks          String?
  /// Загруженные файлы этапа (DriveDocument.shipmentEventId).
  documents         DriveDocument[]
  /// Ожидаемый этап: запланирован, ещё не произошёл.
  expected          Boolean             @default(false)
  createdById       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  updatedById       String?
  lines             ShipmentEventLine[]

  @@index([shipmentId])
  @@index([occurredAt])
}

/// Что сделано по строке отгрузки на этапе: по сколько штук, принято / не принято / возвращено.
model ShipmentEventLine {
  id             String        @id @default(cuid())
  eventId        String
  event          ShipmentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shipmentLineId String
  shipmentLine   ShipmentLine  @relation(fields: [shipmentLineId], references: [id], onDelete: Cascade)
  qty            Int?
  accepted       Int?
  rejected       Int?
  returned       Int?
  comment        String?

  @@index([eventId])
  @@index([shipmentLineId])
}

// Журнал примерок: по ТЗ (а значит и по модели) — дата, размер, итог,
// комментарий и фото, сделанные по факту примерки.
enum FittingStatus {
  PLANNED
  HELD_REMARKS
  HELD_OK
}

model Fitting {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  fittingDate       DateTime
  size              String?
  status            FittingStatus   @default(PLANNED)
  comment           String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  photos            FittingPhoto[]

  @@index([organizationId])
  @@index([productionOrderId])
}

model FittingPhoto {
  id           String   @id @default(cuid())
  fittingId    String
  fitting      Fitting  @relation(fields: [fittingId], references: [id], onDelete: Cascade)
  storagePath  String
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([fittingId])
}

enum PurchaseDocumentKind {
  AUCTION_INVOICE // счёт аукциона на лоты
  SPECIFICATION // спецификация / приложение к договору
  ADVANCE_INVOICE // счёт на аванс
  CALC_SHEET // расчётный лист (Excel)
  UPD // УПД / акт
  PAYMENT_PROOF // платёжный документ (платёжка)
  OTHER
}

// Документ закупки: лежит на диске в UPLOAD_DIR (см. src/lib/purchase-files.ts).
// purchaseId задан — документ относится к одной закупке (счёт аукциона на её
// лоты); иначе документ партии — все закупки с тем же `batch`
// (Purchase.auctionSession, напр. «СП 09-26»): спецификация, расчётный лист,
// счёт на аванс.
model PurchaseDocument {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseId     String?
  purchase       Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  /// Лот, к которому прикреплён документ (УПД, счёт, спецификация лота); purchaseId при этом тоже задан — документ виден и в закупке.
  lotId          String?
  lot            RawMaterialLot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)
  batch          String?
  kind           PurchaseDocumentKind @default(OTHER)
  title          String
  storagePath    String
  originalName   String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime             @default(now())
  payments       Payment[]

  @@index([organizationId, batch])
  @@index([purchaseId])
  @@index([lotId])
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
}

// Свой столбец таблицы лотов (режим «Аукцион» и карточка закупки): общий для всей
// организации. Значения лежат в PurchaseItem.extra по ключу id столбца.
model CustomField {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         String          @default("PURCHASE_ITEM")
  name           String
  type           CustomFieldType @default(TEXT)
  position       Int             @default(0)
  createdAt      DateTime        @default(now())

  @@unique([organizationId, entity, name])
  @@index([organizationId, entity, position])
}

// ---------- Партии производства и документы Google Drive ----------

// Партия поставки производства (в Google Drive — «поставка N»): группирует ТЗ.
/// Цвет составного ТЗ: несколько цветов в одном приложении (NAVY ×2 (42, 46); BLACK ×1 (42)).
model ProductionOrderColor {
  id         String          @id @default(cuid())
  orderId    String
  order      ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  colorRefId String
  colorRef   ColorRef        @relation(fields: [colorRefId], references: [id])
  quantity   Int?
  sizes      String?
  createdAt  DateTime        @default(now())

  @@index([orderId])
  @@index([colorRefId])
}

model ProductionBatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         Int
  name           String?
  year           Int?
  plannedUnits   Int?
  notes          String?
  createdAt      DateTime     @default(now())

  orders         ProductionOrder[]
  driveDocuments DriveDocument[]
  shipments      Shipment[]
  // Подтверждение строки человеком (или автоматически по документам): «сумма и документ корректны».
  // verifiedBy: id пользователя либо "auto:<основание>"; сброс = null.
  verifiedAt     DateTime?
  verifiedBy     String?
  verifyNote     String?

  @@unique([organizationId, number])
  @@index([organizationId])
}

enum DriveDocType {
  AUCTION_INVOICE
  UPD
  CALC_SHEET
  SPECIFICATION
  CONTRACT
  TZ_APPENDIX
  PAYMENT_PROOF
  PAYMENT_INVOICE
  APPROVAL_EMAIL
  BALANCE
  OTHER
}

// Ссылка на файл в Google Drive (сам файл не хранится). Один файл может быть
// привязан к нескольким сущностям — отдельной строкой на каждую привязку.
model DriveDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driveFileId    String
  title          String
  docType        DriveDocType @default(OTHER)
  mimeType       String?
  sizeBytes      Int?
  drivePath      String?
  viewUrl        String?
  docDate        DateTime?
  docNumber      String?
  year           Int?
  notes          String?
  createdAt      DateTime     @default(now())
  // Оригинал файла в приложении (необязательно): путь относительно UPLOAD_DIR, имя на диске — uuid.
  storagePath    String?
  storedName     String?
  storedMime     String?
  storedSize     Int?
  storedAt       DateTime?

  purchaseId          String?
  purchase            Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  lotId               String?
  lot                 RawMaterialLot?    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  productionOrderId   String?
  productionOrder     ProductionOrder?   @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionBatchId   String?
  productionBatch     ProductionBatch?   @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  paymentId           String?
  payment             Payment?           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  productionPaymentId String?
  productionPayment   ProductionPayment? @relation(fields: [productionPaymentId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplierId          String?
  supplier            Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  shipmentEventId     String?
  shipmentEvent       ShipmentEvent?     @relation(fields: [shipmentEventId], references: [id], onDelete: Cascade)

  @@index([organizationId, driveFileId])
  @@index([purchaseId])
  @@index([lotId])
  @@index([productionOrderId])
  @@index([productionBatchId])
  @@index([paymentId])
  @@index([productionPaymentId])
  @@index([clientId])
  @@index([supplierId])
  @@index([shipmentEventId])
}

/// Журнал изменений (аудит): кто, когда и что изменил. Пишется автоматически расширением клиента (src/lib/prisma.ts)
/// в одной транзакции с самой правкой. Без внешних ключей — запись переживает удаление исходной строки.
/// changes: update — {поле: [было, стало]}; create — снимок созданного; delete — полный снимок удалённого.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  at             DateTime @default(now())
  actorId        String?
  actorName      String?
  actorRole      String?
  /// "ui" | "script:<имя>" | "system"
  source         String
  model          String
  recordId       String
  /// "create" | "update" | "delete"
  action         String
  changes        Json
  label          String?
  /// Общий id одной операции (многострочные действия группируются).
  batchId        String?

  @@index([organizationId, at])
  @@index([model, recordId])
  @@index([actorId])
}

// ---------- Комментарии к частям проекта («Оставить комментарий») ----------
// Замечание/ошибка/идея/вопрос, привязанные к странице, записи, блоку или выделенному тексту; потом выгружаются списком задач на доработку.
enum CommentStatus {
  OPEN
  DONE
  WONTFIX
}

enum CommentKind {
  REMARK
  BUG
  IDEA
  QUESTION
}

enum CommentPriority {
  LOW
  NORMAL
  HIGH
}

model Comment {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  authorName     String
  authorRole     String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  text           String
  status         CommentStatus   @default(OPEN)
  kind           CommentKind     @default(REMARK)
  priority       CommentPriority @default(NORMAL)
  /// Адрес страницы со всеми фильтрами (без #), например /lots?tab=fur
  pagePath       String
  pageTitle      String
  /// Purchase, PurchaseItem, RawMaterialLot, Payment, ProductionOrder, ProductionBatch, ProductModel, Auction, ColorRef, …
  entityType     String?
  entityId       String?
  /// «Закупка З-2026-0014», «ТЗ №19»
  entityLabel    String?
  /// Идентификатор блока страницы: «filters», «table:fur», «tile:production» (data-comment-anchor)
  anchor         String?
  /// Снимок контекста: url, фильтры, год, режим НДС, 4%, роль, окно, цитата выделенного текста, название блока
  context        Json?
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?

  replies CommentReply[]

  @@index([organizationId, status, createdAt])
  @@index([entityType, entityId])
  @@index([pagePath])
}

model CommentReply {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commentId      String
  comment        Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  authorId       String
  authorName     String
  authorRole     String
  createdAt      DateTime     @default(now())
  text           String

  @@index([commentId, createdAt])
  @@index([organizationId])
}

// ---------- Справочник признаков меха («Седина 3», «Дикий», «Тонированный»…) ----------
/// Признак/подвид меха: седина соболя (SIL.1…6), происхождение (дикий/клеточный/баргузинский), обработка, марка. Определяется по описаниям лотов и ТЗ
/// (scripts/apply-fur-attrs.ts, src/lib/fur-attr.ts); лот и ТЗ могут иметь несколько признаков. Фильтр «Признак меха» — параметр attr.
model FurAttrRef {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// «Седина», «Происхождение», «Обработка», «Марка / сорт»
  group          String?
  /// Вид меха (канонический, как в справочнике меха): «Соболь»; null — подходит к любому
  furKind        String?
  aliases        String[]
  description    String?
  /// Владелец подтвердил название и смысл признака
  confirmed      Boolean      @default(false)
  /// Ставить автоматически по тексту описаний; false — только предлагать
  autoDetect     Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lots   RawMaterialLotAttr[]
  orders ProductionOrderAttr[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Признак лота склада. source: auto — поставлен скриптом по тексту, manual — вручную.
model RawMaterialLotAttr {
  lotId     String
  lot       RawMaterialLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  attrId    String
  attr      FurAttrRef     @relation(fields: [attrId], references: [id], onDelete: Restrict)
  source    String         @default("manual")
  createdAt DateTime       @default(now())

  @@id([lotId, attrId])
  @@index([attrId])
}

/// Признак, названный в самом ТЗ (описание материала). Признаки лотов, списанных в ТЗ, учитываются отдельно (производные).
model ProductionOrderAttr {
  orderId   String
  order     ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attrId    String
  attr      FurAttrRef      @relation(fields: [attrId], references: [id], onDelete: Restrict)
  source    String          @default("manual")
  createdAt DateTime        @default(now())

  @@id([orderId, attrId])
  @@index([attrId])
}

/// Версия бюджета (раздел «Бюджет»): прикидка расхода шкур, подкладки и работы по бюджету изделий.
/// Версий на сезон может быть несколько. Параметры (надбавки в %) и дерево «тип сырья → категория → артикул» хранятся JSON — см. src/lib/budget-calc.ts.
model BudgetScenario {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Сезон: «FW27»
  season         String
  name           String
  /// DRAFT — черновик (редактируется), APPROVED — утверждён (только просмотр)
  status         String       @default("DRAFT")
  comment        String?
  /// Версия, из которой эта получена копированием
  parentId       String?
  params         Json
  lines          Json
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())
  createdBy      String?
  updatedBy      String?

  @@index([organizationId, season])
}

enum InboxStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum InboxKind {
  AUCTION_CALC
  TZ
  /// Документ поставщика к закупке или лоту (УПД, спецификация, счёт, письмо)
  DOCUMENT
}

/// «Входящие от поставщика»: расчёт по лотам аукциона или ТЗ, внесённые Веллмехом. Это ЧЕРНОВИК на проверку,
/// а не боевые данные: приём сотрудником создаёт настоящие записи (createdEntityType/Id).
model SupplierInbox {
  id                String      @id @default(cuid())
  organizationId    String
  supplierId        String
  supplier          Supplier    @relation(fields: [supplierId], references: [id])
  createdById       String
  kind              InboxKind
  status            InboxStatus @default(DRAFT)
  title             String
  payload           Json
  note              String?
  reviewNote        String?
  sentAt            DateTime?
  decidedAt         DateTime?
  decidedById       String?
  createdEntityType String?
  createdEntityId   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  files SupplierInboxFile[]

  @@index([organizationId, status])
  @@index([supplierId, status])
}

enum InboxFileKind {
  AUCTION_INVOICE
  PAYMENT_INVOICE
  SPECIFICATION
  UPD
  OTHER
}

/// Вложение к входящему (PDF аукционного счёта, счёт Веллмеха, спецификация, УПД). Файл лежит в UPLOAD_DIR.
model SupplierInboxFile {
  id           String        @id @default(cuid())
  inboxId      String
  inbox        SupplierInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  storagePath  String
  originalName String
  mimeType     String
  sizeBytes    Int
  kind         InboxFileKind @default(OTHER)
  createdAt    DateTime      @default(now())

  @@index([inboxId])
}

/// Этап сырья аукциона: Веллмех отмечает, где сырьё и когда его ждать (куплено, выделка, тонировка, логистика…).
/// Ведётся на весь аукцион (lotId пусто) или на отдельный лот. Справочник этапов — src/lib/raw-stage.ts.
model SupplierRawStage {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  purchaseId     String
  purchase       Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  lotId          String?
  lot            RawMaterialLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  /// Номер лота аукциона (у ещё не принятых лотов своей записи RawMaterialLot нет, поэтому лот называем по номеру).
  lotNumber      String?
  stage          String
  /// PLANNED / IN_PROGRESS / DONE
  status         String         @default("PLANNED")
  /// Завод / склад / город: Прогресс, МК ЛИС, XIN, Финляндия, Калининград, Москва…
  place          String?
  plannedStart   DateTime?
  plannedEnd     DateTime?
  factStart      DateTime?
  factEnd        DateTime?
  /// Сколько шкур на этапе
  qty            Int?
  note           String?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, purchaseId])
  @@index([supplierId, status])
}

// ───────── Чат с поставщиком и мост в мессенджеры ─────────
enum ChatKind {
  GENERAL
  REQUEST
}

enum ChatStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum ChatSide {
  INTERNAL
  SUPPLIER
  EXTERNAL
}

enum ChatSource {
  PLATFORM
  TELEGRAM
  WHATSAPP
}

enum ChannelType {
  TELEGRAM
  WHATSAPP
}

enum ChannelLinkKind {
  PRIVATE
  GROUP
}

/// Обсуждение (общий чат с поставщиком по записи или без неё). supplierId = null — внутреннее.
model ChatThread {
  id              String      @id @default(cuid())
  /// Короткий номер обсуждения («#12») — для команды /t в мессенджере.
  number          Int         @unique @default(autoincrement())
  organizationId  String
  supplierId      String?
  kind            ChatKind    @default(GENERAL)
  subject         String
  entityType      String?
  entityId        String?
  entityLabel     String?
  entityHref      String?
  requestType     String?
  status          ChatStatus  @default(OPEN)
  createdById     String
  createdByName   String
  createdBySide   ChatSide
  lastMessageAt   DateTime    @default(now())
  lastMessageSide ChatSide
  createdAt       DateTime    @default(now())
  closedAt        DateTime?
  closedById      String?

  messages ChatMessage[]
  reads    ChatRead[]

  @@index([organizationId, supplierId, lastMessageAt])
  @@index([entityType, entityId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  threadId       String
  thread         ChatThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  organizationId String
  authorId       String?
  authorName     String
  authorSide     ChatSide
  body           String
  source         ChatSource       @default(PLATFORM)
  externalId     String?
  replyToId      String?
  createdAt      DateTime         @default(now())
  editedAt       DateTime?
  /// Когда сообщение разослано по мессенджерам (null — ещё нет).
  dispatchedAt   DateTime?

  attachments ChatAttachment[]
  deliveries  ChannelDelivery[]

  @@unique([source, externalId])
  @@index([threadId, createdAt])
}

model ChatAttachment {
  id           String      @id @default(cuid())
  messageId    String
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storagePath  String
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime    @default(now())

  @@index([messageId])
}

model ChatRead {
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  lastReadAt DateTime   @default(now())

  @@id([threadId, userId])
}

/// Привязка чата мессенджера: к человеку (PRIVATE, userId), к группе поставщика (GROUP, supplierId) или к внутренней группе (GROUP без обоих).
model ChannelLink {
  id               String          @id @default(cuid())
  organizationId   String
  channel          ChannelType
  userId           String?
  supplierId       String?
  externalChatId   String
  externalUsername String?
  kind             ChannelLinkKind
  verifiedAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@unique([channel, externalChatId])
  @@index([organizationId])
}

model ChannelBindCode {
  code           String          @id
  organizationId String
  userId         String?
  supplierId     String?
  kind           ChannelLinkKind
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime        @default(now())
}

/// Что и куда уже отправлено в мессенджер: защита от дублей и привязка ответов «reply» к обсуждению.
model ChannelDelivery {
  id                String      @id @default(cuid())
  messageId         String
  message           ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  threadId          String
  channel           ChannelType
  externalChatId    String
  externalMessageId String
  createdAt         DateTime    @default(now())

  @@unique([messageId, channel, externalChatId])
  @@unique([channel, externalChatId, externalMessageId])
}
